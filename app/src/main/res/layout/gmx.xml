<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#FF10151C"
>
	<!-- ==================== 登录区 ==================== -->
	<ScrollView
			android:id="@+id/gm_login_lay"
			android:padding="0.0dip"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
	>
		<LinearLayout
				android:orientation="vertical"
				android:paddingLeft="18.0dip"
				android:paddingTop="18.0dip"
				android:paddingRight="18.0dip"
				android:paddingBottom="18.0dip"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
		>
			<TextView
					android:id="@+id/gm_title"
					android:textSize="22.0sp"
					android:textStyle="bold"
					android:textColor="#FF6FD3FF"
					android:gravity="center"
					android:paddingBottom="6.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="GM 管理后台"
			>
			</TextView>
			<TextView
					android:id="@+id/gm_desc"
					android:textSize="12.0sp"
					android:textColor="#FF8A97A6"
					android:gravity="center"
					android:paddingBottom="16.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="需 arch 权限的巫师账号，且该账号不能同时在游戏中在线"
			>
			</TextView>
			<TextView
					android:textSize="14.0sp"
					android:textColor="#FFB9C7D6"
					android:paddingBottom="4.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="服务器（域名或IP:端口）"
			>
			</TextView>
			<EditText
					android:textSize="16.0sp"
					android:textColor="#FF000000"
					android:id="@+id/gm_server_edit"
					android:background="@drawable/mudqwerlimaandb4"
					android:paddingLeft="12.0dip"
					android:paddingRight="12.0dip"
					android:layout_width="match_parent"
					android:layout_height="44.0dip"
					android:hint="frp-net.com:27356"
					android:singleLine="true"
					android:inputType="text"
			>
			</EditText>
			<TextView
					android:textSize="14.0sp"
					android:textColor="#FFB9C7D6"
					android:paddingTop="12.0dip"
					android:paddingBottom="4.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="GM 账号"
			>
			</TextView>
			<EditText
					android:textSize="16.0sp"
					android:textColor="#FF000000"
					android:id="@+id/gm_id_edit"
					android:background="@drawable/mudqwerlimaandb4"
					android:paddingLeft="12.0dip"
					android:paddingRight="12.0dip"
					android:layout_width="match_parent"
					android:layout_height="44.0dip"
					android:hint="巫师账号"
					android:singleLine="true"
					android:inputType="text"
			>
			</EditText>
			<TextView
					android:textSize="14.0sp"
					android:textColor="#FFB9C7D6"
					android:paddingTop="12.0dip"
					android:paddingBottom="4.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="GM 密码"
			>
			</TextView>
			<EditText
					android:textSize="16.0sp"
					android:textColor="#FF000000"
					android:id="@+id/gm_pass_edit"
					android:background="@drawable/mudqwerlimaandb4"
					android:paddingLeft="12.0dip"
					android:paddingRight="12.0dip"
					android:layout_width="match_parent"
					android:layout_height="44.0dip"
					android:hint="巫师密码"
					android:singleLine="true"
					android:inputType="textPassword"
			>
			</EditText>
			<LinearLayout
					android:orientation="horizontal"
					android:paddingTop="20.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
			>
				<Button
						android:textSize="17.0sp"
						android:id="@+id/gm_login_bt"
						android:layout_width="0.0dip"
						android:layout_height="46.0dip"
						android:layout_marginRight="8.0dip"
						android:layout_weight="2.0"
						android:text="连 接"
				>
				</Button>
				<Button
						android:textSize="17.0sp"
						android:id="@+id/gm_close_bt"
						android:layout_width="0.0dip"
						android:layout_height="46.0dip"
						android:layout_weight="1.0"
						android:text="返 回"
				>
				</Button>
			</LinearLayout>
			<TextView
					android:textSize="13.0sp"
					android:textColor="#FFFFB4A2"
					android:id="@+id/gm_status"
					android:paddingTop="14.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
			>
			</TextView>
		</LinearLayout>
	</ScrollView>
	<!-- ==================== 主区 ==================== -->
	<LinearLayout
			android:orientation="vertical"
			android:id="@+id/gm_main_lay"
			android:visibility="gone"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
	>
		<LinearLayout
				android:orientation="horizontal"
				android:background="#FF1B2430"
				android:gravity="center_vertical"
				android:paddingLeft="6.0dip"
				android:paddingTop="6.0dip"
				android:paddingRight="6.0dip"
				android:paddingBottom="6.0dip"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
		>
			<Button
					android:textSize="13.0sp"
					android:id="@+id/gm_refresh_bt"
					android:layout_width="wrap_content"
					android:layout_height="42.0dip"
					android:layout_marginRight="6.0dip"
					android:text="在线列表"
			>
			</Button>
			<EditText
					android:textSize="14.0sp"
					android:textColor="#FF000000"
					android:id="@+id/gm_search_edit"
					android:background="@drawable/mudqwerlimaandb4"
					android:paddingLeft="10.0dip"
					android:paddingRight="10.0dip"
					android:layout_width="0.0dip"
					android:layout_height="42.0dip"
					android:layout_weight="1.0"
					android:hint="玩家ID"
					android:singleLine="true"
					android:inputType="text"
			>
			</EditText>
			<Button
					android:textSize="13.0sp"
					android:id="@+id/gm_search_bt"
					android:layout_width="wrap_content"
					android:layout_height="42.0dip"
					android:layout_marginLeft="6.0dip"
					android:layout_marginRight="6.0dip"
					android:text="查 询"
			>
			</Button>
			<Button
					android:textSize="13.0sp"
					android:id="@+id/gm_logout_bt"
					android:layout_width="wrap_content"
					android:layout_height="42.0dip"
					android:text="断 开"
			>
			</Button>
		</LinearLayout>
		<TextView
				android:textSize="13.0sp"
				android:textColor="#FF7FE0A0"
				android:id="@+id/gm_who"
				android:background="#FF131A24"
				android:paddingLeft="10.0dip"
				android:paddingTop="6.0dip"
				android:paddingRight="10.0dip"
				android:paddingBottom="6.0dip"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
		>
		</TextView>
		<ScrollView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
		>
			<LinearLayout
					android:orientation="vertical"
					android:id="@+id/gm_content"
					android:paddingLeft="8.0dip"
					android:paddingTop="8.0dip"
					android:paddingRight="8.0dip"
					android:paddingBottom="24.0dip"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
			>
			</LinearLayout>
		</ScrollView>
	</LinearLayout>
</RelativeLayout>
